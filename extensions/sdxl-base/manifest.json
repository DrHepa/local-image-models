{
  "id": "sdxl-base",
  "name": "SDXL Base",
  "type": "model",
  "description": "Self-contained SDXL Base model extension scaffold for local text-to-image and image-to-image workflows.",
  "version": "0.1.1",
  "author": "DrHepa",
  "generator_class": "SDXLBaseGenerator",
  "tags": [
    "text-to-image",
    "image-to-image",
    "sdxl",
    "local"
  ],
  "nodes": [
    {
      "id": "text-to-image",
      "name": "Text to Image",
      "input": "text",
      "output": "image",
      "hf_repo": "stabilityai/stable-diffusion-xl-base-1.0",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Prompt text for SDXL base generation."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "blurry, low quality, distorted, artifacts",
          "tooltip": "Quality preset applied by default; set an empty string to disable it explicitly."
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 1024,
          "min": 64,
          "max": 2048
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 1024,
          "min": 64,
          "max": 2048
        },
        {
          "id": "steps",
          "label": "Steps",
          "type": "int",
          "default": 30,
          "min": 1,
          "max": 150
        },
        {
          "id": "guidance_scale",
          "label": "Guidance Scale",
          "type": "float",
          "default": 5.0,
          "min": 0,
          "max": 50,
          "tooltip": "Lower values are often enough for SDXL base."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42,
          "min": 0,
          "max": 2147483647
        },
        {
          "id": "output_format",
          "label": "Output Format",
          "type": "select",
          "default": "png",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpeg",
              "label": "JPEG"
            }
          ],
          "tooltip": "File format for generated images. PNG preserves existing behavior; JPEG supports output_quality."
        },
        {
          "id": "output_quality",
          "label": "JPEG Quality",
          "type": "int",
          "default": 85,
          "min": 1,
          "max": 100,
          "tooltip": "JPEG quality from 1 to 100. Only valid when output_format is jpeg."
        }
      ]
    },
    {
      "id": "image-to-image",
      "name": "Image to Image",
      "input": "image",
      "output": "image",
      "inputs": [
        {
          "name": "front",
          "label": "Primary image",
          "type": "image",
          "required": true
        },
        {
          "name": "left",
          "label": "Style reference",
          "type": "image",
          "required": false
        }
      ],
      "style_reference": {
        "label": "Style reference",
        "optional": true,
        "role": "style"
      },
      "hf_repo": "stabilityai/stable-diffusion-xl-base-1.0",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Optional text guidance for the edit pass."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "blurry, low quality, distorted, artifacts",
          "tooltip": "Quality preset applied by default; set an empty string to disable it explicitly."
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 1024,
          "min": 64,
          "max": 2048
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 1024,
          "min": 64,
          "max": 2048
        },
        {
          "id": "strength",
          "label": "Strength",
          "type": "float",
          "default": 0.7,
          "min": 0,
          "max": 1,
          "tooltip": "Controls how much the source image is changed."
        },
        {
          "id": "steps",
          "label": "Steps",
          "type": "int",
          "default": 30,
          "min": 1,
          "max": 150
        },
        {
          "id": "guidance_scale",
          "label": "Guidance Scale",
          "type": "float",
          "default": 5.0,
          "min": 0,
          "max": 50,
          "tooltip": "Lower values are often enough for SDXL base."
        },
        {
          "id": "reference_strength",
          "label": "Reference Strength",
          "type": "float",
          "default": 0.6,
          "min": 0,
          "max": 1,
          "tooltip": "Controls optional SDXL IP-Adapter style reference guidance; the primary image remains the init image."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42,
          "min": 0,
          "max": 2147483647
        },
        {
          "id": "output_format",
          "label": "Output Format",
          "type": "select",
          "default": "png",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpeg",
              "label": "JPEG"
            }
          ],
          "tooltip": "File format for generated images. PNG preserves existing behavior; JPEG supports output_quality."
        },
        {
          "id": "output_quality",
          "label": "JPEG Quality",
          "type": "int",
          "default": 85,
          "min": 1,
          "max": 100,
          "tooltip": "JPEG quality from 1 to 100. Only valid when output_format is jpeg."
        }
      ]
    }
  ]
}
