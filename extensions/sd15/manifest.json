{
  "id": "sd15",
  "name": "Stable Diffusion 1.5",
  "type": "model",
  "description": "Self-contained SD15 model extension scaffold for local text-to-image and image-to-image workflows.",
  "version": "0.1.1",
  "author": "DrHepa",
  "generator_class": "SD15Generator",
  "tags": [
    "text-to-image",
    "image-to-image",
    "stable-diffusion",
    "local"
  ],
  "nodes": [
    {
      "id": "text-to-image",
      "name": "Text to Image",
      "input": "text",
      "output": "image",
      "hf_repo": "runwayml/stable-diffusion-v1-5",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Prompt text to generate from."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "blurry, low quality, bad anatomy, deformed, extra digits",
          "tooltip": "Quality preset applied by default; set an empty string to disable it explicitly."
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 512,
          "min": 64,
          "max": 2048
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 512,
          "min": 64,
          "max": 2048
        },
        {
          "id": "steps",
          "label": "Steps",
          "type": "int",
          "default": 30,
          "min": 1,
          "max": 150
        },
        {
          "id": "guidance_scale",
          "label": "Guidance Scale",
          "type": "float",
          "default": 7.5,
          "min": 0,
          "max": 50,
          "tooltip": "How strongly generation follows the prompt."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42,
          "min": 0,
          "max": 2147483647
        },
        {
          "id": "output_format",
          "label": "Output Format",
          "type": "select",
          "default": "png",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpeg",
              "label": "JPEG"
            }
          ],
          "tooltip": "File format for generated images. PNG preserves existing behavior; JPEG supports output_quality."
        },
        {
          "id": "output_quality",
          "label": "JPEG Quality",
          "type": "int",
          "default": 85,
          "min": 1,
          "max": 100,
          "tooltip": "JPEG quality from 1 to 100. Only valid when output_format is jpeg."
        }
      ]
    },
    {
      "id": "image-to-image",
      "name": "Image to Image",
      "input": "image",
      "output": "image",
      "inputs": [
        {
          "name": "front",
          "label": "Primary image",
          "type": "image",
          "required": true
        },
        {
          "name": "left",
          "label": "Style reference",
          "type": "image",
          "required": false
        }
      ],
      "style_reference": {
        "label": "Style reference",
        "optional": true,
        "role": "style"
      },
      "hf_repo": "runwayml/stable-diffusion-v1-5",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Optional prompt describing the desired edit target."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "blurry, low quality, bad anatomy, deformed, extra digits",
          "tooltip": "Quality preset applied by default; set an empty string to disable it explicitly."
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 512,
          "min": 64,
          "max": 2048
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 512,
          "min": 64,
          "max": 2048
        },
        {
          "id": "strength",
          "label": "Strength",
          "type": "float",
          "default": 0.75,
          "min": 0,
          "max": 1,
          "tooltip": "How strongly the source image should be transformed."
        },
        {
          "id": "steps",
          "label": "Steps",
          "type": "int",
          "default": 30,
          "min": 1,
          "max": 150
        },
        {
          "id": "guidance_scale",
          "label": "Guidance Scale",
          "type": "float",
          "default": 7.5,
          "min": 0,
          "max": 50,
          "tooltip": "How strongly generation follows the prompt."
        },
        {
          "id": "reference_strength",
          "label": "Reference Strength",
          "type": "float",
          "default": 0.6,
          "min": 0,
          "max": 1,
          "tooltip": "Controls optional SD1.5 IP-Adapter style reference guidance; the primary image remains the init image."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42,
          "min": 0,
          "max": 2147483647
        },
        {
          "id": "output_format",
          "label": "Output Format",
          "type": "select",
          "default": "png",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpeg",
              "label": "JPEG"
            }
          ],
          "tooltip": "File format for generated images. PNG preserves existing behavior; JPEG supports output_quality."
        },
        {
          "id": "output_quality",
          "label": "JPEG Quality",
          "type": "int",
          "default": 85,
          "min": 1,
          "max": 100,
          "tooltip": "JPEG quality from 1 to 100. Only valid when output_format is jpeg."
        }
      ]
    }
  ]
}
